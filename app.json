{
  "expo": {
    "name": "OutNow Tickets",
    "slug": "outnow-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "outnowtickets",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.outnowtickets.app",
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:outnowtickets.com",
        "applinks:www.outnowtickets.com"
      ],
      "icon": "./assets/expo.icon",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.outnowtickets.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "outnowtickets.com",
              "pathPrefix": "/events"
            },
            {
              "scheme": "https",
              "host": "www.outnowtickets.com",
              "pathPrefix": "/events"
            },
            {
              "scheme": "https",
              "host": "outnowtickets.com",
              "pathPrefix": "/tickets"
            },
            {
              "scheme": "https",
              "host": "www.outnowtickets.com",
              "pathPrefix": "/tickets"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow OutNow Tickets to access Face ID."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow OutNow Tickets to access your photos so you can choose event cover images.",
          "cameraPermission": false,
          "microphonePermission": false,
          "colors": {
            "cropToolbarColor": "#FFFFFF",
            "cropToolbarIconColor": "#111827",
            "cropToolbarActionTextColor": "#7C3AED",
            "cropBackButtonIconColor": "#111827",
            "cropBackgroundColor": "#FFFFFF"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow OutNow Tickets to use your camera to scan event ticket QR codes.",
          "microphonePermission": "Allow OutNow Tickets to use your microphone.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
