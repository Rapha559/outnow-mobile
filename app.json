{
  "expo": {
    "name": "OutNow Tickets",
    "slug": "outnow-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "outnowtickets",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.outnowtickets.app",
      "buildNumber": "11",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "OutNow Tickets uses your camera to scan event ticket QR codes at check-in.",
        "NSLocationWhenInUseUsageDescription": "OutNow Tickets needs your location to securely process in-person payments with Stripe Terminal.",
        "NSBluetoothAlwaysUsageDescription": "OutNow Tickets uses Bluetooth to connect secure Stripe card readers."
      },
      "associatedDomains": [
        "applinks:outnowtickets.com",
        "applinks:www.outnowtickets.com"
      ],
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.outnowtickets.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#050505",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "outnowtickets.com",
              "pathPrefix": "/events"
            },
            {
              "scheme": "https",
              "host": "www.outnowtickets.com",
              "pathPrefix": "/events"
            },
            {
              "scheme": "https",
              "host": "outnowtickets.com",
              "pathPrefix": "/tickets"
            },
            {
              "scheme": "https",
              "host": "www.outnowtickets.com",
              "pathPrefix": "/tickets"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "@stripe/stripe-terminal-react-native",
        {
          "bluetoothBackgroundMode": true,
          "tapToPayCheck": true,
          "appDelegate": true,
          "locationWhenInUsePermission": "OutNow Tickets needs your location to securely process in-person payments with Stripe Terminal.",
          "bluetoothAlwaysUsagePermission": "OutNow Tickets uses Bluetooth to connect secure Stripe card readers."
        }
      ],
      "expo-notifications",
      "expo-apple-authentication",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow OutNow Tickets to use Face ID to protect Box Office and Tap to Pay access."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow OutNow Tickets to use Face ID to protect Box Office and Tap to Pay access."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow OutNow Tickets to access your photos so you can choose event cover images.",
          "microphonePermission": false,
          "colors": {
            "cropToolbarColor": "#FFFFFF",
            "cropToolbarIconColor": "#111827",
            "cropToolbarActionTextColor": "#7C3AED",
            "cropBackButtonIconColor": "#111827",
            "cropBackgroundColor": "#FFFFFF"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "OutNow Tickets uses your camera to scan event ticket QR codes at check-in.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow OutNow Tickets to use your location to show events near you."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050505",
          "image": "./assets/images/logo-glow.png",
          "imageWidth": 190
        }
      ],
      "expo-sharing",
      "expo-web-browser",
      "expo-image",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "969d4981-87de-4914-8d0a-152ee30f8f54"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/969d4981-87de-4914-8d0a-152ee30f8f54"
    }
  }
}
